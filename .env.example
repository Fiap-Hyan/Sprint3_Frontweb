# Modelo das variáveis de ambiente do projeto. As chaves em uso ficam no arquivo
# `.env` da raiz; copie este modelo para `.env.local` se quiser sobrescrevê-las
# com chaves próprias (o `.env.local` não é versionado no Git).

# Google Gemini — usado em src/services/api.js
VITE_GOOGLE_API_KEY=

# Google Cloud Text-to-Speech — usado em src/services/textToSpeech.js
VITE_GOOGLE_TTS_KEY=
